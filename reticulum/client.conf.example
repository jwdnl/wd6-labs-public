# Add one of these interfaces below the [interfaces] section in your existing
# Reticulum configuration. Do not copy this file over a complete configuration.

[[WD6 Amsterdam]]
  type = TCPClientInterface
  enabled = yes
  target_host = rns.wd6.net
  target_port = 4242

# RNS versions with BackboneInterface support can use this alternative instead:
#
# [[WD6 Amsterdam Backbone]]
#   type = BackboneInterface
#   enabled = yes
#   remote = rns.wd6.net
#   target_port = 4242

# Use only one alternative for this gateway. Ordinary end-user clients should
# keep enable_transport = no. Community/radio operators: see CONNECT.md and
# community.conf.example for boundary/internal interface guidance.
